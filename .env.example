# 값은 넣지 않는다. 복사해서 .env.local(로컬) / 배포 환경변수(Vercel)에 채운다.
# 검증은 src/lib/env.ts가 한다 — 필수 값이 없으면 부팅 시 죽는다.

# ── M1부터 필요 ────────────────────────────────────────────
DATABASE_URL=
ANSWER_KEY=            # D-017 · 교체 불가. 잠긴 편지가 전부 안 열린다
FP_KEY=                # D-017 · 교체 가능
NEXT_PUBLIC_SITE_URL=  # D-022 · https://postfeel.kr

# ── M2 이후에 쓰기 시작한다 ────────────────────────────────
CONFIRMATION_KEY=      # D-017 · M2에서 사용
ADMIN_SESSION_KEY=     # D-017 · M2에서 사용
ADMIN_PASSWORD=        # 05-api §4 · 키가 아니라 비밀번호
OPENAI_API_KEY=        # D-020
CRON_SECRET=           # 05-api §1 재분류 잡 인증. 크론은 GitHub Actions가 부른다
                       # (`reclassify.yml` 워크플로 · 공개 저장소에는 없다). 16자 이상 랜덤
RESEND_API_KEY=        # D-019
TELEGRAM_BOT_TOKEN=    # D-019
TELEGRAM_CHAT_ID=

# ── M7 (M0 답 반영) ────────────────────────────────────────
QUARANTINE_KEY=        # D-028 · 격리된 편지 본문의 봉인 키
                       # **ACCESS_LOG_KEY와 반드시 다른 값.** 같으면 격리 본문을 여는
                       # 코드가 접속기록도 열 수 있고, 키를 나눈 경계가 사라진다
                       # 비면 격리를 건너뛴다 — 비공개는 되지만 본문이 letters에 남는다
ACCESS_LOG_KEY=        # D-030 · 법정 접속기록의 원본 IP 봉인 키
                       # **교체 불가에 가깝다** — 바꾸면 그 이전 3개월치를 복호할 수 없고,
                       # 못 읽는 기록은 보관하지 않은 것과 같다
                       # **비면 접속기록이 조용히 안 남는다.** 배포 후 게이트 17번으로 확인한다

# ANSWER_KEY / FP_KEY / CONFIRMATION_KEY / ADMIN_SESSION_KEY / ACCESS_LOG_KEY 생성:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
