# 이 파일은 커밋한다. 테스트 전용 고정값이며 실제 시크릿이 아니다.
# 실제 값을 여기에 적지 않는다 — 적는 순간 이 파일은 커밋하면 안 되는 파일이 된다.
#
# DATABASE_URL은 "테스트가 붙을 서버"만 가리킨다. 실제 테스트는 이 DB를 쓰지 않고
# tests/setup/이 실행마다 postfeel_test_* DB를 새로 만들어 쓰고 지운다.
# CI 등에서 진짜 환경변수가 이미 있으면 그쪽이 이긴다 (vitest.config.ts).

DATABASE_URL=postgresql://postfeel:postfeel@localhost:54329/postfeel

ANSWER_KEY=test-answer-key-not-a-real-secret
FP_KEY=test-fp-key-not-a-real-secret
CONFIRMATION_KEY=test-confirmation-key-not-a-real-secret
ADMIN_SESSION_KEY=test-admin-session-key-not-a-real-secret
ADMIN_PASSWORD=test-admin-password

# D-030 · 법정 접속기록의 IP 봉인 키. 없으면 recordAccess가 아무것도 남기지 않으므로
# 값이 있어야 "봉인된 채로 저장된다"를 잴 수 있다.
ACCESS_LOG_KEY=test-access-log-key-not-a-real-secret

# D-028 · 격리 본문 봉인 키. ACCESS_LOG_KEY와 **다른 값**이어야 한다 — 같으면
# 격리 본문을 여는 코드가 접속기록도 열 수 있고, 키를 나눈 이유가 사라진다.
QUARANTINE_KEY=test-quarantine-key-not-a-real-secret

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 외부 API는 테스트에서 호출하지 않는다. 비워 둔 채로 두고, 필요한 테스트는 스텁을 쓴다.
OPENAI_API_KEY=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
